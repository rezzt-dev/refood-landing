---
import { ArrowLeft, ArrowRight, ArrowUpRight, Check, Leaf, MapPin, Search, ShoppingBag, UtensilsCrossed } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const steps = [
  { number: '01', title: 'Explora', text: 'Descubre restaurantes cercanos con comida preparada para aprovechar.', icon: Search },
  { number: '02', title: 'Reserva', text: 'Elige un pack sorpresa y confirma cuándo pasarás a recogerlo.', icon: ShoppingBag },
  { number: '03', title: 'Disfruta', text: 'Recoge tu pedido, disfruta de buena comida y ayuda a reducir el desperdicio.', icon: Check },
];
const examples = [
  { name: 'Asador San Huberto', category: 'Asador', description: 'Especialidades al horno de leña', image: '/images/restaurante-san-huberto.webp', imageAlt: 'Fachada del Asador San Huberto', imageWidth: 1200, imageHeight: 900, logo: false },
  { name: 'Mesón Restaurante Octavio', category: 'Cocina tradicional', description: 'Cocina tradicional manchega', image: '/images/restaurante-octiavia.webp', imageAlt: 'Fachada del Mesón Restaurante Octavio', imageWidth: 1440, imageHeight: 1080, logo: false },
  { name: 'Orosia', category: 'Tapas y vegetal', description: 'Tapas y opciones vegetales', image: '/images/restaurante-orosia.webp', imageAlt: 'Logotipo de Orosia', imageWidth: 960, imageHeight: 720, logo: true },
];
---

<BaseLayout title="re:food — Una segunda oportunidad para cada plato" description="Conoce re:food, una propuesta para conectar comida excedente de restaurantes con personas que quieren aprovecharla.">
  <SiteHeader />

  <main id="contenido">
    <section id="inicio" class="hero relative overflow-hidden">
      <div class="hero-image" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div>
      <div class="container relative z-10 flex min-h-[680px] flex-col justify-center py-24 lg:min-h-[760px]">
        <div class="max-w-[750px] text-white" data-intro>
          <p class="hero-label"><span class="h-2 w-2 rounded-full bg-lime"></span> re:food · una idea que está tomando forma</p>
          <h1 class="mt-8 font-display text-[clamp(2.75rem,7vw,6rem)] leading-[1.03] tracking-[-0.035em]">La comida buena <em class="font-normal text-lime">no debería terminar aquí.</em></h1>
          <p class="mt-7 max-w-[55ch] text-base leading-8 text-white/85 sm:text-lg">Imaginamos una forma de acercar la comida que sobra en los restaurantes a quienes quieren disfrutarla. Una segunda oportunidad para cada plato.</p>
          <div class="mt-9 flex flex-wrap items-center gap-6"><a class="button button-light" href="#como-funciona">Descubre la idea <ArrowRight size={18} aria-hidden="true" /></a><a class="hero-secondary" href="#proyecto">Por qué existe</a></div>
        </div>
        <p class="hero-footnote">Proyecto académico en desarrollo · Aún no hay reservas disponibles</p>
        <a class="hero-scroll-cue" href="#proyecto" aria-label="Desplazarse al proyecto"><span class="hero-scroll-line" aria-hidden="true"></span> Desliza para descubrir</a>
      </div>
    </section>

    <section id="proyecto" class="section-pad project-section bg-cream">
      <div class="container grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr] lg:gap-24">
        <div data-reveal><p class="section-kicker"><span class="kicker-line"></span> La idea detrás de re:food</p><h2 class="section-title mt-6">Todo ese cuidado <em class="text-leaf">merece continuar.</em></h2></div>
        <div class="project-copy max-w-[55ch]" data-reveal><p class="text-lg leading-8 text-ink/80">Detrás de un plato hay ingredientes, tiempo y manos que lo han preparado. Si sigue en buen estado, que no se venda no significa que haya perdido su valor.</p><p class="mt-5 leading-8 text-ink/75">re:food propone un encuentro sencillo entre cocinas con excedentes y personas que quieren darles una segunda oportunidad.</p></div>
      </div>
      <div class="container project-statement" aria-hidden="true">Lo bueno merece seguir.</div>
    </section>

    <section class="exchange-section" aria-labelledby="exchange-title">
      <div class="container exchange-heading" data-reveal>
        <p class="exchange-overline">Una idea, dos lados de la mesa</p>
        <h2 id="exchange-title">Cuando compartimos lo que sobra, <em>ganamos todos.</em></h2>
      </div>
      <div class="container exchange-grid">
        <article class="exchange-panel exchange-panel-dark" data-reveal>
          <span class="exchange-index">Para las cocinas</span>
          <div><UtensilsCrossed size={36} stroke-width={1.3} aria-hidden="true" /><h3>Que el trabajo de hoy llegue más lejos.</h3><p>Una forma de ofrecer la comida preparada que sigue siendo buena al final del servicio, en lugar de dejarla atrás.</p></div>
        </article>
        <article class="exchange-panel exchange-panel-light" data-reveal>
          <span class="exchange-index">Para las personas</span>
          <div><ShoppingBag size={36} stroke-width={1.3} aria-hidden="true" /><h3>Descubrir, recoger y disfrutar cerca.</h3><p>La posibilidad de encontrar un pack sorpresa en el barrio y disfrutar de comida preparada con una historia que continúa.</p></div>
        </article>
      </div>
      <p class="container exchange-disclaimer">Así funcionaría la propuesta cuando exista una plataforma operativa. Actualmente no hay establecimientos ni packs disponibles.</p>
    </section>

    <section id="como-funciona" class="story-section bg-white" data-story>
      <div class="container story-intro"><div class="max-w-[650px]" data-reveal><p class="section-kicker"><span class="kicker-line"></span> Así lo imaginamos</p><h2 class="section-title mt-6">Tres pasos. Un plato que no se pierde.</h2></div><p class="max-w-[34ch] text-sm leading-7 text-ink/70" data-reveal>Desplázate para seguir el recorrido que estamos construyendo de principio a fin.</p></div>
      <div class="container story-layout">
        <div class="story-visual" aria-hidden="true" data-story-visual>
          <div class="story-visual-top"><span>El recorrido</span><span><span data-story-number>01</span> / 03</span></div>
          <div class="story-plate"><div class="story-plate-inner"><Leaf size={52} stroke-width={1.1} /></div></div>
          <div class="story-visual-bottom"><span class="story-visual-name" data-story-name>Explora</span><span class="story-visual-arrow">↗</span></div>
          <div class="story-visual-progress"><span></span></div>
        </div>
        <div class="story-steps">
          {steps.map((step) => <article class="story-step" data-story-step data-number={step.number} data-title={step.title}>
            <div class="story-step-index"><span>{step.number} / 03</span><step.icon size={30} stroke-width={1.5} aria-hidden="true" /></div>
            <h3>{step.title}</h3><p>{step.text}</p>
          </article>)}
        </div>
      </div>
      <p class="container story-note">Este recorrido describe la propuesta del proyecto; la plataforma todavía está en desarrollo.</p>
    </section>

    <section id="restaurantes" class="restaurant-section bg-mist" aria-labelledby="restaurant-title" data-gallery>
      <div class="container gallery-heading" data-reveal>
        <div>
          <p class="section-kicker"><span class="kicker-line"></span> Colección de restaurantes <span class="gallery-count">01 — 0{examples.length}</span></p>
          <h2 id="restaurant-title" class="section-title mt-6">Cada cocina tiene <em class="text-leaf">algo que compartir.</em></h2>
        </div>
        <p class="gallery-intro">Las imágenes del prototipo ayudan a imaginar una comunidad de cocinas distintas. Son referencias visuales, no locales adheridos a una plataforma activa.</p>
      </div>

      <div class="container gallery-collection" data-gallery-track role="region" aria-label="Colección visual de restaurantes" tabindex="0">
        {examples.map((example, index) => <article class:list={['restaurant-card', { 'restaurant-card-featured': index === 0, 'restaurant-card-logo': example.logo }]} data-gallery-card data-reveal>
          <div class="restaurant-image-wrap">
            <img src={example.image} alt={example.imageAlt} loading="lazy" decoding="async" width={example.imageWidth} height={example.imageHeight} />
            <span class="restaurant-image-index" aria-hidden="true">0{index + 1} / 0{examples.length}</span>
          </div>
          <div class="restaurant-card-body">
            <span class="restaurant-category"><span aria-hidden="true"></span>{example.category}</span>
            <div class="restaurant-card-copy"><h3>{example.name}</h3><p>{example.description}</p></div>
            <span class="restaurant-card-mark" aria-hidden="true"><Leaf size={21} stroke-width={1.5} /></span>
          </div>
        </article>)}
      </div>

      <div class="container gallery-bottom">
        <p><strong>Una colección para imaginar lo que viene.</strong> Referencias visuales del prototipo original: estos locales no participan actualmente y no hay packs disponibles.</p>
        <div class="gallery-controls" data-gallery-controls role="group" aria-label="Controles de la colección">
          <span class="gallery-current" aria-live="polite"><span data-gallery-current>01</span> <span aria-hidden="true">/</span> 0{examples.length}</span>
          <button type="button" class="gallery-control" data-gallery-prev aria-label="Ver restaurante anterior" disabled><ArrowLeft size={20} aria-hidden="true" /></button>
          <button type="button" class="gallery-control" data-gallery-next aria-label="Ver siguiente restaurante"><ArrowRight size={20} aria-hidden="true" /></button>
        </div>
      </div>
    </section>

    <section id="impacto" class="purpose-section bg-forest text-white" data-purpose>
      <div class="container purpose-layout">
        <div class="purpose-heading" data-reveal><p class="section-kicker text-lime"><span class="kicker-line bg-lime"></span> Nuestro propósito</p><h2 class="section-title mt-6">Pequeñas decisiones, <em class="text-lime">un cambio compartido.</em></h2><span class="purpose-heading-mark" aria-hidden="true">re:food / 03</span></div>
        <div class="purpose-list">
          <article class="purpose-item" data-reveal><span class="purpose-index">01</span><UtensilsCrossed class="purpose-icon" size={30} stroke-width={1.5} aria-hidden="true" /><div><h3>Dar valor a cada plato</h3><p>Aprovechar comida preparada que sigue teniendo mucho que ofrecer.</p></div></article>
          <article class="purpose-item" data-reveal><span class="purpose-index">02</span><Leaf class="purpose-icon" size={30} stroke-width={1.5} aria-hidden="true" /><div><h3>Reducir el desperdicio</h3><p>Impulsar hábitos más responsables en nuestro día a día.</p></div></article>
          <article class="purpose-item" data-reveal><span class="purpose-index">03</span><MapPin class="purpose-icon" size={30} stroke-width={1.5} aria-hidden="true" /><div><h3>Conectar el barrio</h3><p>Acercar las cocinas locales a las personas de su entorno.</p></div></article>
        </div>
      </div>
    </section>

    <section class="closing-section bg-lime py-20 sm:py-24"><div class="container flex flex-wrap items-end justify-between gap-9"><div class="max-w-[730px]" data-reveal><h2 class="section-title text-forest">Hagamos sitio para una nueva forma de aprovechar.</h2><p class="mt-6 max-w-[60ch] leading-8 text-forest/85">re:food está tomando forma. Mientras llega la experiencia completa, descubre la idea y compártela con quien también crea que la comida merece una segunda oportunidad.</p></div><a class="button button-dark" href="#inicio">Volver al inicio <ArrowUpRight size={18} aria-hidden="true" /></a></div></section>
  </main>

  <SiteFooter />

  <script src="../scripts/home-motion.ts"></script>
  <script src="../scripts/restaurant-gallery.ts"></script>
</BaseLayout>
