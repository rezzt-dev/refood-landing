---
import { Leaf } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="re:food — proyecto en preparación">
  <main class="grid min-h-screen place-items-center px-6 py-16">
    <div class="max-w-2xl text-center" data-intro>
      <Leaf class="mx-auto mb-6 text-leaf" size={40} stroke-width={1.5} aria-hidden="true" />
      <p class="text-xl font-semibold tracking-[-0.02em] sm:text-2xl">re:food</p>
      <h1 class="mt-6 font-display text-[clamp(2.75rem,7vw,5rem)] font-medium leading-[1.08] tracking-[-0.025em] text-balance">
        Una segunda oportunidad para cada plato.
      </h1>
      <p class="mx-auto mt-7 max-w-[42ch] text-base leading-relaxed text-ink/75 sm:text-lg">
        Un proyecto en preparación para aprovechar mejor la comida.
      </p>
    </div>
  </main>

  <script>
    import { animate } from 'animejs';

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      animate('[data-intro]', {
        opacity: [0, 1],
        translateY: [12, 0],
        duration: 650,
        ease: 'outCubic',
      });
    }
  </script>
</BaseLayout>
